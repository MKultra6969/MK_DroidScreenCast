{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "MK DroidScreenCast",
  "version": "2.0.0",
  "identifier": "com.mkdsc.app",
  "build": {
    "beforeDevCommand": "npm run tauri:dev",
    "beforeBuildCommand": "npm run tauri:build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist-tauri"
  },
  "app": {
    "windows": [
      {
        "title": "MK DroidScreenCast",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MKultra6969/MK_DroidScreenCast/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0QkY4MDJDMDM3QjZEQjMKUldTemJYc0RMSUMvaEM0cHFPbzhxNGh5REFmVzltLzdFRHBPdEJGOEhSV0NxdjFCUVhhQXQ2ZGUK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
