{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "MK DroidScreenCast",
  "version": "1.0.2",
  "identifier": "com.mkdsc.app",
  "build": {
    "beforeDevCommand": "npm run tauri:dev",
    "beforeBuildCommand": "npm run tauri:build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist-tauri"
  },
  "app": {
    "windows": [
      {
        "title": "MK DroidScreenCast",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: http://127.0.0.1:6969; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:6969 ws://127.0.0.1:6969"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MKultra6969/MK_DroidScreenCast/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "../bin",
      "../mkdsc",
      "../templates",
      "../static",
      "../tauri_backend.py",
      "../requirements.txt"
    ]
  }
}
