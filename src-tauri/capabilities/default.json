{
  "identifier": "main-default",
  "description": "Default permissions for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-ask",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/*" },
        { "url": "https://t.me/*" }
      ]
    },
    "updater:default",
    "process:default"
  ]
}
