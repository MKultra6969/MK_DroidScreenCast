# Tauri / Rust
src-tauri/target/

# Environment files
.env
.env.*
# Not a secret — just the localhost address of the backend. Without it a clean
# clone builds a desktop app whose requests never reach 127.0.0.1:6969.
!frontend/.env.tauri

# Config is mutated at runtime; ship config.example.json instead.
config.json

# Signing keys — NEVER commit these.
# `~/` is a real directory created by running a command with an unexpanded
# tilde (e.g. `tauri signer generate -w ~/.tauri/mkdsc.key` in a shell that
# does not expand it). The Tauri updater private key must live in the user's
# home directory, not in the repository.
~/
*.key
!*.key.pub

